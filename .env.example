# 로컬에서는 비워 두고 Vite /api 프록시를 쓴다.
# Netlify에는 https://petory-api.likelion.shop 을 넣고 브라우저가 API로 바로 요청하게 한다.
VITE_API_BASE_URL=

# 로컬 스프링을 띄우면 http://localhost:8080
VITE_API_PROXY_TARGET=https://petory-api.likelion.shop

# PortOne V2 (공개 가능한 값)
VITE_PORTONE_STORE_ID=store-00c1a14d-aad0-4f96-a998-dc06dfafbad0
VITE_PORTONE_CHANNEL_KEY=
